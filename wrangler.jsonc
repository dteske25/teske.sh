{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teske-sh",
  "compatibility_date": "2026-11-03",
  "routes": [
    {
      "pattern": "teske.sh/*",
      "zone_name": "teske.sh"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teske-sh-intake",
      "database_id": "e1e9958c-19a3-4855-8140-e33b5331bd77"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "teske-sh-intake-preview",
        "database_id": "1e6ca14b-bff0-4775-9cc5-5ad7385d1c87"
      }
    ]
  }
}
