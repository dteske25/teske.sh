{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teske-sh",
  "compatibility_date": "2026-11-03",
  "routes": [
    {
      "pattern": "teske.sh/*",
      "zone_name": "teske.sh"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teske-sh-intake",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ]
}
